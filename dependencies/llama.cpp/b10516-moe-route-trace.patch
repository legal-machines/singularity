+void llama_moe_offloader::write_route_trace(
+        const moe_layer & layer, const int32_t * ids,
+        const std::vector<uint8_t> & hard_resident_before,
+        int n, int top_k, uint32_t sequence,
+        uint64_t decision_timestamp_nanoseconds,
+        uint64_t state_ready_timestamp_nanoseconds,
+        uint64_t execution_timestamp_nanoseconds) {
+    constexpr uint64_t maximum_route_trace_records = 100000;
+    if (!route_trace_output || top_k <= 0 || n <= 0 || n % top_k != 0) return;
+    const int token_count = n / top_k;
+    for (int token = 0; token < token_count; ++token) {
+        if (route_trace_records >= maximum_route_trace_records) {
+            if (!route_trace_overflow_written) {
+                route_trace_output << "{\"type\":\"overflow\"}\n";
+                route_trace_overflow_written = true;
+                route_trace_output.flush();
+            }
+            return;
+        }
+        route_trace_output << "{\"decision_sequence\":" << sequence
+                << ",\"token\":" << token
+                << ",\"layer\":" << layer.layer_idx
+                << ",\"top_k\":" << top_k
+                << ",\"router_weights\":null"
+                << ",\"decision_timestamp_nanoseconds\":" << decision_timestamp_nanoseconds
+                << ",\"state_ready_timestamp_nanoseconds\":" << state_ready_timestamp_nanoseconds
+                << ",\"execution_timestamp_nanoseconds\":" << execution_timestamp_nanoseconds
+                << ",\"exact_routed_ids\":[";
+        for (int rank = 0; rank < top_k; ++rank) {
+            if (rank) route_trace_output << ',';
+            route_trace_output << ids[token * top_k + rank];
+        }
+        route_trace_output << "],\"hard_resident_before\":[";
+        for (int rank = 0; rank < top_k; ++rank) {
+            if (rank) route_trace_output << ',';
+            route_trace_output << (hard_resident_before[(size_t) token * top_k + rank] ? "true" : "false");
+        }
+        route_trace_output << "],\"soft_resident_estimate_before\":null}\n";
+        route_trace_records++;
     }
+    route_trace_output.flush();
 }
 
