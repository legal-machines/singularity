+expert_pool * find_pool(const void * host_base) {
+    for (const auto & pool : state.pools) {
+        if (pool->host_base == host_base) return pool.get();
+    }
+    return nullptr;
+}
+
+std::unique_ptr<expert_pool> create_pool(
+        const char * name, const void * host_base, std::size_t expert_size,
+        std::int64_t n_in, std::int64_t n_out, int wtype, std::int64_t n_expert) {
+    std::unique_ptr<expert_pool> pool(new expert_pool());
+    pool->host_base = host_base;
+    pool->tensor_name = name ? name : "";
+    pool->expert_size = expert_size;
+    pool->n_in = n_in;
+    pool->n_out = n_out;
+    pool->n_expert = n_expert;
+    pool->type = static_cast<ggml_type>(wtype);
+    pool->slots.resize(static_cast<std::size_t>(state.slot_capacity));
+
+    ggml_init_params parameters = {
+        /* .mem_size = */ ggml_tensor_overhead() * 4,
+        /* .mem_buffer = */ nullptr,
+        /* .no_alloc = */ true,
+    };
+    pool->weight_context = ggml_init(parameters);
+    if (!pool->weight_context) return nullptr;
+    pool->weights = ggml_new_tensor_3d(pool->weight_context, pool->type,
+                                      n_in, n_out, state.slot_capacity);
+    pool->weight_buffer = ggml_backend_alloc_ctx_tensors(pool->weight_context, state.backend);
+    if (!pool->weight_buffer) return nullptr;
+    ggml_backend_buffer_set_usage(pool->weight_buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    if (std::getenv("LOCAL_INFERENCE_MOE_DEBUG")) {
+        std::fprintf(stderr,
+            "moe-fabric-pool: %s source_stride=%zu destination_stride=%zu row_stride=%zu logical_bytes=%zu dims=%lldx%lldx%lld type=%d\n",
+            pool->tensor_name.c_str(), expert_size, pool->weights->nb[2], pool->weights->nb[1],
+            ggml_nbytes(pool->weights), static_cast<long long>(n_in),
+            static_cast<long long>(n_out), static_cast<long long>(n_expert), wtype);
+    }
+    return pool;
+}
+
+graph_instance * graph_for(expert_pool & pool, int count) {
+    if (count <= 0 || count > maximum_routed) return nullptr;
+    if (pool.graphs[count]) return pool.graphs[count].get();
+    std::unique_ptr<graph_instance> instance(new graph_instance());
+    const std::size_t graph_nodes = 8;
+    ggml_init_params parameters = {
+        /* .mem_size = */ ggml_tensor_overhead() * 16 +
+            ggml_graph_overhead_custom(graph_nodes, false),
+        /* .mem_buffer = */ nullptr,
+        /* .no_alloc = */ true,
+    };
+    instance->context = ggml_init(parameters);
+    if (!instance->context) return nullptr;
+    instance->activations = ggml_new_tensor_3d(
+        instance->context, GGML_TYPE_F32, pool.n_in, count, 1);
+    instance->ids = ggml_new_tensor_2d(instance->context, GGML_TYPE_I32, count, 1);
+    instance->output = ggml_mul_mat_id(
+        instance->context, pool.weights, instance->activations, instance->ids);
+    instance->buffer = ggml_backend_alloc_ctx_tensors(instance->context, state.backend);
+    if (!instance->buffer) return nullptr;
+    instance->graph = ggml_new_graph_custom(instance->context, graph_nodes, false);
+    ggml_build_forward_expand(instance->graph, instance->output);
+    instance->host_activations.resize(static_cast<std::size_t>(count * pool.n_in));
+    instance->host_output.resize(static_cast<std::size_t>(count * pool.n_out));
+    instance->host_ids.resize(static_cast<std::size_t>(count));
+    pool.graphs[count] = std::move(instance);
+    return pool.graphs[count].get();
+}
+
+int resident_slot(expert_pool & pool, int expert) {
+    for (std::size_t index = 0; index < pool.slots.size(); ++index) {
+        if (pool.slots[index].expert == expert) return static_cast<int>(index);
+    }
+    return -1;
+}
+
+int admit(expert_pool & pool, int expert) {
+    int victim = -1;
+    std::uint64_t oldest = UINT64_MAX;
+    for (std::size_t index = 0; index < pool.slots.size(); ++index) {
+        const auto & slot = pool.slots[index];
+        if (slot.pinned) continue;
+        if (slot.expert < 0) {
+            victim = static_cast<int>(index);
+            break;
+        }
+        if (slot.stamp < oldest) {
+            oldest = slot.stamp;
+            victim = static_cast<int>(index);
+        }
+    }
+    if (victim < 0) return -1;
+    if (pool.slots[victim].expert >= 0 && pool.slots[victim].expert != expert) {
+        state.telemetry.expert_evictions++;
+    }
+    const auto offset = static_cast<std::size_t>(victim) * pool.expert_size;
+    const auto * source = static_cast<const std::uint8_t *>(pool.host_base) +
+        static_cast<std::size_t>(expert) * pool.expert_size;
+    ggml_backend_tensor_set_async(state.backend, pool.weights, source, offset, pool.expert_size);
+    static bool debug_verified_upload = false;
+    if (!debug_verified_upload && std::getenv("LOCAL_INFERENCE_MOE_DEBUG")) {
+        debug_verified_upload = true;
+        ggml_backend_synchronize(state.backend);
+        std::vector<std::uint8_t> uploaded(pool.expert_size);
+        ggml_backend_tensor_get(pool.weights, uploaded.data(), offset, pool.expert_size);
+        std::size_t mismatches = 0;
+        for (std::size_t index = 0; index < pool.expert_size; ++index) {
+            mismatches += uploaded[index] != source[index] ? 1 : 0;
+        }
+        std::fprintf(stderr, "moe-fabric-upload: tensor=%s expert=%d slot=%d bytes=%zu mismatches=%zu\n",
+                     pool.tensor_name.c_str(), expert, victim, pool.expert_size, mismatches);
+    }
+    pool.slots[victim].expert = expert;
+    pool.slots[victim].stamp = ++state.stamp;
+    pool.slots[victim].pinned = true;
+    return victim;
+}
+
+bool same_route(const logical_route & route, const int32_t * ids, int count) {
+    if (!route.valid || route.count != count) return false;
+    for (int index = 0; index < count; ++index) {
+        if (route.ids[index] != ids[index]) return false;
+    }
+    return true;
+}
+
+void * fabric_begin(const char * tensor_name, const void * host_base, size_t expert_size,
+                    int64_t n_in, int64_t n_out, int wtype, int64_t n_expert, int64_t n_tokens) {
+    if (!state.backend || !host_base || n_tokens <= 0 || n_tokens > maximum_routed) return nullptr;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    const int layer = layer_from_name(tensor_name);
+    const auto now = std::chrono::steady_clock::now();
+    if (layer == 0 && (state.last_control_check.time_since_epoch().count() == 0 ||
+        elapsed_nanoseconds(state.last_control_check, now) >= 50'000'000ULL)) {
+        state.last_control_check = now;
+		(void) apply_controlled_capacity_locked();
+    }
+    expert_pool * pool = find_pool(host_base);
+    if (!pool) {
+        auto created = create_pool(tensor_name, host_base, expert_size,
+                                   n_in, n_out, wtype, n_expert);
+        if (!created) return nullptr;
+        pool = created.get();
+        state.pools.push_back(std::move(created));
+    }
+    node_plan * node = nullptr;
+    for (auto & candidate : state.node_descriptors) {
+        if (!candidate.in_use) {
+            node = &candidate;
+            break;
+        }
+    }
+    if (!node) return nullptr;
+	auto verification_row = std::move(node->verification_row);
+	*node = node_plan{};
+	node->verification_row = std::move(verification_row);
+	if (node->verification_row.size() < static_cast<std::size_t>(n_out))
+		node->verification_row.resize(static_cast<std::size_t>(n_out));
+    node->in_use = true;
+    node->pool = pool;
+    node->layer = layer;
+    node->token_count = static_cast<int>(n_tokens);
+    node->started = std::chrono::steady_clock::now();
+    return node;
+}
+
+int fabric_plan(void * opaque, const int32_t * ids, int count, int32_t * slots) {
+    node_plan * node = static_cast<node_plan *>(opaque);
+    if (!node || !ids || !slots || count <= 0 || count > maximum_routed) return 0;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    node->count = count;
+    std::fill(slots, slots + count, -1);
+    std::array<bool, maximum_routed> gpu{};
+    // The assignment belongs to the logical routed work, not to an individual
+    // projection. Reuse it across gate/up/down (and repeated decode locality)
+    // whenever the layer's exact route is unchanged.
+    const bool continuation = node->layer >= 0 &&
+        same_route(state.routes[node->layer], ids, count);
+    if (continuation) {
+        gpu = state.routes[node->layer].gpu;
+    } else {
+        if (node->layer >= 0) {
+            auto & route = state.routes[node->layer];
+            route.count = count;
+            route.valid = true;
+            for (int index = 0; index < count; ++index) {
+                route.ids[index] = ids[index];
+                route.gpu[index] = gpu[index];
+            }
+        }
+    }
+    int resident_rows = 0;
+    int admitted_rows = 0;
+    int nonresident_cpu_rows = 0;
+    for (int index = 0; index < count; ++index) {
+        node->routed[index] = ids[index];
+        const bool resident_before = resident_slot(*node->pool, ids[index]) >= 0;
+        if (!gpu[index]) {
+            nonresident_cpu_rows += resident_before ? 0 : 1;
+            continue;
+        }
+        int slot = resident_slot(*node->pool, ids[index]);
+        const bool was_resident = slot >= 0;
+        if (slot >= 0 && node->pool->slots[slot].pinned) slot = -1;
+        if (slot < 0) slot = admit(*node->pool, ids[index]);
+        if (slot < 0) continue;
+        node->pool->slots[slot].pinned = true;
+        node->pool->slots[slot].stamp = ++state.stamp;
+        node->slots[index] = slot;
+        slots[index] = slot;
+        if (was_resident) resident_rows++;
+        else admitted_rows++;
+    }
+    int selected = 0;
+    for (int index = 0; index < count; ++index) selected += slots[index] >= 0 ? 1 : 0;
+    state.telemetry.nodes++;
+    state.telemetry.routed_rows += static_cast<std::uint64_t>(count);
+    state.telemetry.gpu_rows += static_cast<std::uint64_t>(selected);
+    state.telemetry.cpu_rows += static_cast<std::uint64_t>(count - selected);
+    state.telemetry.gpu_resident_rows += static_cast<std::uint64_t>(resident_rows);
+    state.telemetry.gpu_admitted_rows += static_cast<std::uint64_t>(admitted_rows);
+	if (count != count - selected + resident_rows + admitted_rows)
+		state.telemetry.routing_accounting_violations++;
+	state.telemetry_dirty = true;
+    state.telemetry.admitted_bytes += static_cast<std::uint64_t>(admitted_rows) * node->pool->expert_size;
+    state.telemetry.cache_hits += static_cast<std::uint64_t>(resident_rows);
+    state.telemetry.cache_misses += static_cast<std::uint64_t>(admitted_rows + nonresident_cpu_rows);
+    state.telemetry.cpu_served_misses += static_cast<std::uint64_t>(nonresident_cpu_rows);
+    state.telemetry.metal_served_misses += static_cast<std::uint64_t>(admitted_rows);
+    if (node->token_count > 1) {
+        state.telemetry.prefill_rows += static_cast<std::uint64_t>(count);
+		state.telemetry.prefill_cpu_rows += static_cast<std::uint64_t>(count - selected);
+		state.telemetry.prefill_gpu_resident_rows += static_cast<std::uint64_t>(resident_rows);
+		state.telemetry.prefill_gpu_admitted_rows += static_cast<std::uint64_t>(admitted_rows);
+        state.telemetry.prefill_cache_hits += static_cast<std::uint64_t>(resident_rows);
+        state.telemetry.prefill_cache_misses += static_cast<std::uint64_t>(admitted_rows + nonresident_cpu_rows);
+    } else {
+        state.telemetry.decode_rows += static_cast<std::uint64_t>(count);
+		state.telemetry.decode_cpu_rows += static_cast<std::uint64_t>(count - selected);
+		state.telemetry.decode_gpu_resident_rows += static_cast<std::uint64_t>(resident_rows);
+		state.telemetry.decode_gpu_admitted_rows += static_cast<std::uint64_t>(admitted_rows);
+        state.telemetry.decode_cache_hits += static_cast<std::uint64_t>(resident_rows);
+        state.telemetry.decode_cache_misses += static_cast<std::uint64_t>(admitted_rows + nonresident_cpu_rows);
+    }
+    return selected;
+}
+
+int fabric_dispatch(void * opaque, int count, const int32_t * slots,
+                    const float * const * activation_rows) {
+    node_plan * node = static_cast<node_plan *>(opaque);
+    if (!node || count <= 0 || !slots || !activation_rows) return 0;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    const auto dispatch_started = std::chrono::steady_clock::now();
+    graph_instance * graph = graph_for(*node->pool, count);
+    if (!graph) return 0;
+    for (int index = 0; index < count; ++index) {
+        std::memcpy(graph->host_activations.data() + index * node->pool->n_in,
+                    activation_rows[index], static_cast<std::size_t>(node->pool->n_in) * sizeof(float));
+        graph->host_ids[index] = slots[index];
+    }
+    ggml_backend_tensor_set_async(state.backend, graph->activations,
+        graph->host_activations.data(), 0, graph->host_activations.size() * sizeof(float));
+    ggml_backend_tensor_set_async(state.backend, graph->ids,
+        graph->host_ids.data(), 0, graph->host_ids.size() * sizeof(int32_t));
+    node->dispatched = ggml_backend_graph_compute_async(state.backend, graph->graph) == GGML_STATUS_SUCCESS;
+    node->dispatch_finished = std::chrono::steady_clock::now();
+    if (node->dispatched && std::getenv("LOCAL_INFERENCE_AI_SERIALIZE_BRANCHES")) {
+		node->serialization_sync_started_nanoseconds =
+			static_cast<std::uint64_t>(ggml_time_us()) * 1000ULL;
+        ggml_backend_synchronize(state.backend);
+		node->serialization_sync_call_nanoseconds =
+			static_cast<std::uint64_t>(ggml_time_us()) * 1000ULL -
+			node->serialization_sync_started_nanoseconds;
+        node->accelerator_nanoseconds = elapsed_nanoseconds(
+            dispatch_started, std::chrono::steady_clock::now());
+		state.telemetry.serialized_branch_nodes++;
+	} else if (node->dispatched) {
+		state.telemetry.concurrent_branch_nodes++;
+    }
+    state.telemetry.dispatch_nanoseconds += elapsed_nanoseconds(
+        dispatch_started, node->dispatch_finished);
+    return node->dispatched ? 1 : 0;
+}
+
+void fabric_cpu_branch_complete(void * opaque, uint64_t cpu_started_nanoseconds,
+		uint64_t cpu_finished_nanoseconds) {
+	node_plan * node = static_cast<node_plan *>(opaque);
+	if (!node) return;
+	std::lock_guard<std::mutex> lock(state.mutex);
+	node->cpu_started_nanoseconds = cpu_started_nanoseconds;
+	node->cpu_finished_nanoseconds = cpu_finished_nanoseconds;
+	node->cpu_branch_nanoseconds = cpu_finished_nanoseconds > cpu_started_nanoseconds
+		? cpu_finished_nanoseconds - cpu_started_nanoseconds : 0;
+	state.telemetry.cpu_branch_nanoseconds += node->cpu_branch_nanoseconds;
+}
+
+float * fabric_verification_buffer(void * opaque, size_t element_count) {
+	node_plan * node = static_cast<node_plan *>(opaque);
+	if (!node || node->verification_row.size() < element_count) return nullptr;
+	return node->verification_row.data();
+}
+
+int fabric_collect(void * opaque, int count, float * const * destinations) {
+    node_plan * node = static_cast<node_plan *>(opaque);
+    if (!node || !node->dispatched || count <= 0 || !destinations) return 0;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    graph_instance * graph = graph_for(*node->pool, count);
+    if (!graph) return 0;
+	const std::uint64_t synchronize_started_nanoseconds =
+		static_cast<std::uint64_t>(ggml_time_us()) * 1000ULL;
+    ggml_backend_synchronize(state.backend);
+    const auto synchronized = std::chrono::steady_clock::now();
+	const std::uint64_t synchronize_finished_nanoseconds =
+		static_cast<std::uint64_t>(ggml_time_us()) * 1000ULL;
+	const std::uint64_t synchronize_call_nanoseconds =
+		synchronize_finished_nanoseconds - synchronize_started_nanoseconds;
+    if (node->accelerator_nanoseconds == 0) {
+        node->accelerator_nanoseconds = elapsed_nanoseconds(node->dispatch_finished, synchronized);
+    }
+	state.telemetry.metal_branch_wall_nanoseconds += node->accelerator_nanoseconds;
+	state.telemetry.branch_critical_path_nanoseconds += elapsed_nanoseconds(
+		node->dispatch_finished, synchronized);
+	ggml_metal_execution_timing metal_timing{};
+	if (node->cpu_started_nanoseconds > 0 && ggml_backend_metal_last_execution_timing(
+		state.backend, node->cpu_started_nanoseconds, node->cpu_finished_nanoseconds,
+		&metal_timing)) {
+		state.telemetry.metal_useful_execution_nanoseconds +=
+			metal_timing.gpu_useful_execution_nanoseconds;
+		state.telemetry.actual_simultaneous_execution_nanoseconds +=
+			metal_timing.simultaneous_cpu_gpu_nanoseconds;
+		const std::uint64_t cpu_wait = metal_timing.gpu_finished_nanoseconds >
+			node->cpu_finished_nanoseconds
+			? metal_timing.gpu_finished_nanoseconds - node->cpu_finished_nanoseconds : 0;
+		const std::uint64_t metal_wait = node->cpu_finished_nanoseconds >
+			metal_timing.gpu_finished_nanoseconds
+			? node->cpu_finished_nanoseconds - metal_timing.gpu_finished_nanoseconds : 0;
+		state.telemetry.cpu_waiting_for_metal_nanoseconds += cpu_wait;
+		state.telemetry.metal_waiting_for_cpu_nanoseconds += metal_wait;
+		const std::uint64_t effective_sync_started =
+			node->serialization_sync_started_nanoseconds > 0
+				? node->serialization_sync_started_nanoseconds : synchronize_started_nanoseconds;
+		const std::uint64_t effective_sync_call =
+			node->serialization_sync_call_nanoseconds > 0
+				? node->serialization_sync_call_nanoseconds : synchronize_call_nanoseconds;
+		const std::uint64_t synchronization_wait = metal_timing.gpu_finished_nanoseconds >
+			effective_sync_started
+			? metal_timing.gpu_finished_nanoseconds - effective_sync_started : 0;
+		state.telemetry.synchronization_mechanism_nanoseconds +=
+			effective_sync_call > synchronization_wait
+				? effective_sync_call - synchronization_wait : 0;
+	} else {
+		// GPU command timestamps are unavailable on this OS/device. Preserve the
+		// raw call duration only as mechanism+unknown wait, never as overhead.
+		state.telemetry.synchronization_mechanism_nanoseconds +=
+			node->serialization_sync_call_nanoseconds > 0
+				? node->serialization_sync_call_nanoseconds : synchronize_call_nanoseconds;
+	}
+    ggml_backend_tensor_get(graph->output, graph->host_output.data(), 0,
+                            graph->host_output.size() * sizeof(float));
+    for (int index = 0; index < count; ++index) {
+        std::memcpy(destinations[index], graph->host_output.data() + index * node->pool->n_out,
+                    static_cast<std::size_t>(node->pool->n_out) * sizeof(float));
+    }
+    state.telemetry.merge_nanoseconds += elapsed_nanoseconds(
+        synchronized, std::chrono::steady_clock::now());
+	state.telemetry_dirty = true;
+    return 1;
+}
+
+void fabric_verification(void * opaque, double max_absolute_error,
+                         double max_relative_error, double max_reference_magnitude,
+                         double squared_error, double squared_reference,
+                         uint64_t compared_elements, uint64_t cpu_reference_nanoseconds) {
+    node_plan * node = static_cast<node_plan *>(opaque);
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (node && node->pool->n_out > 0) {
+        state.telemetry.verification_rows += compared_elements /
+            static_cast<std::uint64_t>(node->pool->n_out);
+    }
+    state.telemetry.verification_elements += compared_elements;
+    if (max_absolute_error > state.telemetry.verification_max_absolute_error) {
+        state.telemetry.verification_max_absolute_error = max_absolute_error;
+        state.telemetry.verification_worst_tensor = node ? node->pool->tensor_name : "";
+    }
+    state.telemetry.verification_max_relative_error = std::max(
+        state.telemetry.verification_max_relative_error, max_relative_error);
+    if (max_reference_magnitude > 0.0) {
+        state.telemetry.verification_max_normalized_error = std::max(
+            state.telemetry.verification_max_normalized_error,
+            max_absolute_error / max_reference_magnitude);
+    }
+    state.telemetry.verification_squared_error += squared_error;
+    state.telemetry.verification_squared_reference += squared_reference;
+	state.telemetry_dirty = true;
+}
+
+void fabric_end(void * opaque) {
+    node_plan * node = static_cast<node_plan *>(opaque);
+    if (!node) return;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    for (auto & slot : node->pool->slots) slot.pinned = false;
+    node->in_use = false;
+}
+
+void fabric_invalidate(const void * base, size_t size) {
+    if (!base || size == 0) return;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    const auto first = reinterpret_cast<std::uintptr_t>(base);
+    const auto last = first + size;
+    state.pools.erase(std::remove_if(state.pools.begin(), state.pools.end(),
+        [&](const std::unique_ptr<expert_pool> & pool) {
+            const auto address = reinterpret_cast<std::uintptr_t>(pool->host_base);
+            return address >= first && address < last;
+        }), state.pools.end());
+}
+
+} // namespace
+
+void ggml_metal_moe_fabric_register(ggml_backend_t backend) {
+    (void) backend;
+}
+
+void ggml_metal_moe_fabric_unregister(ggml_backend_t backend) {
+    (void) backend;
+}
