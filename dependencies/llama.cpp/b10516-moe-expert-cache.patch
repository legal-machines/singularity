+int configured_slots() {
+    std::string controlled;
+    if (const char * path = std::getenv("LOCAL_INFERENCE_MOE_HETEROGENEOUS_CONTROL")) {
+        std::ifstream input(path);
+        if (input) input >> controlled;
+    }
+    const char * value = controlled.empty()
+        ? std::getenv("LOCAL_INFERENCE_MOE_HETEROGENEOUS_SLOTS") : controlled.c_str();
+    if (!value || !*value) return 4;
+    const int parsed = std::atoi(value);
+    return std::max(1, std::min(parsed, maximum_routed));
+}
+
+bool apply_controlled_capacity_locked() {
+	const int desired = configured_slots();
+	if (desired == state.slot_capacity) return false;
+	for (const auto &node : state.node_descriptors) {
+		if (node.in_use) return false;
+	}
+	// No graph callback owns a pool at this safe point. Finish queued Metal
+	// work before destroying buffers so the physical allocation is released.
+	if (state.backend) ggml_backend_synchronize(state.backend);
+	state.pools.clear();
+	state.routes = {};
+	state.slot_capacity = desired;
+	state.telemetry.pool_reconfigurations++;
+	write_telemetry();
+	state.telemetry_dirty = false;
+	return true;
+}
+
+void control_loop() {
+	while (!state.stop_control.load()) {
+		std::this_thread::sleep_for(std::chrono::milliseconds(50));
+		if (state.stop_control.load()) break;
+		std::lock_guard<std::mutex> lock(state.mutex);
+		const bool reconfigured = apply_controlled_capacity_locked();
+		if (!reconfigured && state.telemetry_dirty) {
+			write_telemetry();
+			state.telemetry_dirty = false;
+		}
+	}
+}
