+bool ggml_metal_last_execution_timing(ggml_metal_t ctx,
+		uint64_t cpu_started_nanoseconds, uint64_t cpu_finished_nanoseconds,
+		struct ggml_metal_execution_timing * timing) {
+	if (!ctx || !timing) return false;
+	// MTLCommandBuffer GPUStartTime/GPUEndTime use mach absolute time on
+	// macOS. ggml's cross-platform CPU timing uses CLOCK_MONOTONIC, whose
+	// epoch can diverge after system sleep. Sample both clocks together and
+	// translate Metal timestamps before comparing branch intervals.
+	mach_timebase_info_data_t timebase;
+	mach_timebase_info(&timebase);
+	const uint64_t mach_nanoseconds = mach_absolute_time() * timebase.numer / timebase.denom;
+	struct timespec monotonic_time;
+	clock_gettime(CLOCK_MONOTONIC, &monotonic_time);
+	const uint64_t monotonic_nanoseconds =
+		(uint64_t) monotonic_time.tv_sec * 1000000000ULL + (uint64_t) monotonic_time.tv_nsec;
+	const int64_t metal_to_monotonic_offset =
+		(int64_t) mach_nanoseconds - (int64_t) monotonic_nanoseconds;
+	struct interval { uint64_t start; uint64_t end; } intervals[GGML_METAL_MAX_COMMAND_BUFFERS + 1];
+	int count = 0;
+	for (int index = 0; index <= ctx->n_cb; ++index) {
+		id<MTLCommandBuffer> command = ctx->cmd_bufs[index].obj;
+		if (!command || command.status != MTLCommandBufferStatusCompleted ||
+			command.GPUStartTime <= 0.0 || command.GPUEndTime <= command.GPUStartTime) continue;
+		const int64_t raw_start = (int64_t) (command.GPUStartTime * 1000000000.0);
+		const int64_t raw_end = (int64_t) (command.GPUEndTime * 1000000000.0);
+		const int64_t translated_start = raw_start - metal_to_monotonic_offset;
+		const int64_t translated_end = raw_end - metal_to_monotonic_offset;
+		if (translated_start < 0 || translated_end <= translated_start) continue;
+		intervals[count++] = (struct interval) {
+			(uint64_t) translated_start, (uint64_t) translated_end};
+	}
+	if (count == 0) return false;
+	for (int left = 0; left < count; ++left) {
+		for (int right = left + 1; right < count; ++right) {
+			if (intervals[right].start < intervals[left].start) {
+				struct interval temporary = intervals[left];
+				intervals[left] = intervals[right];
+				intervals[right] = temporary;
+			}
+		}
+	}
+	uint64_t useful = 0;
+	uint64_t simultaneous = 0;
+	uint64_t merged_start = intervals[0].start;
+	uint64_t merged_end = intervals[0].end;
+	for (int index = 1; index <= count; ++index) {
+		if (index < count && intervals[index].start <= merged_end) {
+			if (intervals[index].end > merged_end) merged_end = intervals[index].end;
+			continue;
+		}
+		useful += merged_end - merged_start;
+		const uint64_t overlap_start = merged_start > cpu_started_nanoseconds
+			? merged_start : cpu_started_nanoseconds;
+		const uint64_t overlap_end = merged_end < cpu_finished_nanoseconds
+			? merged_end : cpu_finished_nanoseconds;
+		if (overlap_end > overlap_start) simultaneous += overlap_end - overlap_start;
+		if (index < count) {
+			merged_start = intervals[index].start;
+			merged_end = intervals[index].end;
+		}
