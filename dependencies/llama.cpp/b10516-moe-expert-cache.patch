+double measured_value(const char * name) {
+    const char * text = std::getenv(name);
+    if (!text || !*text) return 0.0;
+    char * end = nullptr;
+    const double value = std::strtod(text, &end);
+    return end && end != text && *end == '\0' && value > 0.0 ? value : 0.0;
+}
+
+std::uint64_t measured_integer(const char * name) {
+    const double value = measured_value(name);
+    return value >= static_cast<double>(UINT64_MAX) ? UINT64_MAX : static_cast<std::uint64_t>(value);
+}
+
+int layer_from_name(const char * name) {
+    if (!name || std::strncmp(name, "blk.", 4) != 0) return -1;
+    char * end = nullptr;
+    const long layer = std::strtol(name + 4, &end, 10);
+    if (!end || end == name + 4 || layer < 0 || layer >= maximum_layers) return -1;
+    return static_cast<int>(layer);
+}
