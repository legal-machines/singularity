{
  "name": "singularity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js --host 127.0.0.1",
    "typecheck": "node verify-source.mjs",
    "build": "vite build --config vite.config.js && vite build --config vite.office.config.js && node verify-dist.mjs",
    "test": "vitest run --config vite.config.js --passWithNoTests",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "qr": "0.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.1",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  }
}
