#include <windows.h>

#define IDI_APP_ICON 101
IDI_APP_ICON ICON "@NATIVE_APP_WINDOWS_ICON@"
@NATIVE_APP_WINDOWS_MANIFEST_RESOURCE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Legal Machines\0"
      VALUE "FileDescription", "@NATIVE_APP_DISPLAY_NAME@\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "@NATIVE_APP_SLUG@\0"
      VALUE "OriginalFilename", "@NATIVE_APP_DISPLAY_NAME@.exe\0"
      VALUE "ProductName", "@NATIVE_APP_DISPLAY_NAME@\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
